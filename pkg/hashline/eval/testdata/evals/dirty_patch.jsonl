# LLM "脏 patch" 容错 — 真实模型输出的格式偏差 (commit 4ec17e2 兼容层)

# D1: op 关键字小写 → 大小写不敏感解析
{"name": "dirty-case-insensitive-ops", "files": {"test.go": "one\ntwo\n"}, "patch": "*** Begin Patch\n[test.go#TAG]\nswap 1.=1\n%OLD\none\n%NEW\n1\n*** End Patch", "expect_files": {"test.go": "1\ntwo\n"}}

# D2: op 行尾注释(# 分隔)被剥离
{"name": "dirty-trailing-comment", "files": {"test.go": "one\ntwo\n"}, "patch": "*** Begin Patch\n[test.go#TAG]\nDEL 1 # remove first line\n*** End Patch", "expect_files": {"test.go": "two\n"}}

# D3: INS 空格变体 "INS. POST" → normalizeOpLine 归一化
{"name": "dirty-ins-spacing-variant", "files": {"test.go": "one\ntwo\n"}, "patch": "*** Begin Patch\n[test.go#TAG]\nINS. POST 1:\nmiddle\n*** End Patch", "expect_files": {"test.go": "one\nmiddle\ntwo\n"}}

# D4: legacy 引号语法 SWAP "text": + body — OldString 是行内容定位器,命中行整行替换
{"name": "dirty-legacy-quoted-swap", "files": {"test.go": "first\nhello\nthird\n"}, "patch": "*** Begin Patch\n[test.go#TAG]\nSWAP \"hello\":\nhi\n*** End Patch", "expect_files": {"test.go": "first\nhi\nthird\n"}}

# D5: ops 之间夹空行 → 解析跳过,不影响应用
{"name": "dirty-blank-lines-between-ops", "files": {"test.go": "one\ntwo\nthree\n"}, "patch": "*** Begin Patch\n[test.go#TAG]\nSWAP 1.=1\n%OLD\none\n%NEW\n1\n\nDEL 3\n*** End Patch", "expect_files": {"test.go": "1\ntwo\n"}}
