# TAG 过期自动恢复 — RecoverOps LCS 行号重映射 (recovery.go:43)
# snapshot_files = read 时的版本; files = 当前磁盘版本(被外部修改过)

# R1: 外部改了无关行,SWAP 目标行未变 → LCS 重映射成功,warning "auto-recovered"
{"name": "recovery-success-target-intact", "files": {"test.go": "alpha\nbeta CHANGED\ngamma\n"}, "snapshot_files": {"test.go": "alpha\nbeta\ngamma\n"}, "patch": "*** Begin Patch\n[test.go#TAG]\nSWAP 3.=3\n%OLD\ngamma\n%NEW\nGAMMA\n*** End Patch", "expect_files": {"test.go": "alpha\nbeta CHANGED\nGAMMA\n"}, "expect_warning_contains": "auto-recovered"}

# R2: 外部改了 SWAP 目标行 → MapModified 冲突,recovery 失败 → tag_mismatch,文件不变
{"name": "recovery-fail-target-modified", "files": {"test.go": "alpha\nbeta\ngamma CHANGED\n"}, "snapshot_files": {"test.go": "alpha\nbeta\ngamma\n"}, "patch": "*** Begin Patch\n[test.go#TAG]\nSWAP 3.=3\n%OLD\ngamma\n%NEW\nGAMMA\n*** End Patch", "expect_error_kind": "tag_mismatch", "expect_files": {"test.go": "alpha\nbeta\ngamma CHANGED\n"}}

# R3: 外部在文件头插入行 → op 行号 3 重映射为 4,编辑落到正确位置
{"name": "recovery-success-line-shift", "files": {"test.go": "INSERTED\nalpha\nbeta\ngamma\n"}, "snapshot_files": {"test.go": "alpha\nbeta\ngamma\n"}, "patch": "*** Begin Patch\n[test.go#TAG]\nSWAP 3.=3\n%OLD\ngamma\n%NEW\nGAMMA\n*** End Patch", "expect_files": {"test.go": "INSERTED\nalpha\nbeta\nGAMMA\n"}, "expect_warning_contains": "auto-recovered"}
