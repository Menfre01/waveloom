# 渐进匹配(progressive matching)— 固化自 test-newedit skill Part N
# 匹配策略链: exact → NFC → rstrip → trim → NFKC (patcher.go matchContent)

# N1: 尾随空白容错(rstrip fallback)— 文件 line1 带 2 个尾随空格,%OLD 不带 → 匹配成功
{"name": "progressive-rstrip", "files": {"test.go": "line1  \nline2\n"}, "patch": "*** Begin Patch\n[test.go#TAG]\nSWAP 1.=2\n%OLD\nline1\nline2\n%NEW\nreplaced1\nreplaced2\n*** End Patch", "expect_files": {"test.go": "replaced1\nreplaced2\n"}}

# N2: 前导空白容错(trim fallback)— line1 带 2 个前导空格,line2 带前导 tab
{"name": "progressive-trim", "files": {"test.go": "  line1\n\tline2\n"}, "patch": "*** Begin Patch\n[test.go#TAG]\nSWAP 1.=2\n%OLD\nline1\nline2\n%NEW\nreplaced1\nreplaced2\n*** End Patch", "expect_files": {"test.go": "replaced1\nreplaced2\n"}}

# N3: Unicode 归一化(NFC fallback)— 文件为 NFC 编码(é), %OLD 使用 NFD 编码(é)
{"name": "progressive-nfc", "files": {"test.go": "r\u00e9sum\u00e9\n"}, "patch": "*** Begin Patch\n[test.go#TAG]\nSWAP 1.=1\n%OLD\nre\u0301sume\u0301\n%NEW\nREPLACED\n*** End Patch", "expect_files": {"test.go": "REPLACED\n"}}

# N4: 完全不匹配 → 全部 fallback 失败 → invalid_args,文件不被修改
{"name": "progressive-nomatch", "files": {"test.go": "hello world\n"}, "patch": "*** Begin Patch\n[test.go#TAG]\nSWAP 1.=1\n%OLD\ncompletely different\n%NEW\nshould fail\n*** End Patch", "expect_error_kind": "invalid_args", "expect_files": {"test.go": "hello world\n"}}
